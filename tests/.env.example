# Copy this file to tests/.env.local and set values for your board or runner.
# tests/.env.local is ignored by git and is auto-loaded by tests/test.sh.

# Single RTSP stream URL for single-stream e2e tests.
# SIMANEAT_APPS_TEST_RTSP_URL=rtsp://<host>:<port>/<stream>

# Comma-separated RTSP URLs for multistream e2e tests.
# SIMANEAT_APPS_TEST_RTSP_URLS=rtsp://<host>:<port>/<stream0>,rtsp://<host>:<port>/<stream1>

# Override asset paths if the defaults under APPS_ROOT do not match your checkout.
# SIMANEAT_APPS_TEST_MODELS_DIR=/abs/path/to/assets/models
# SIMANEAT_APPS_TEST_INPUT_DIR=/abs/path/to/assets/test_images
# SIMANEAT_APPS_TEST_CLASSIFICATION_IMAGE=/abs/path/to/goldfish.jpeg

# E2E output and timeout settings.
# SIMANEAT_APPS_TEST_OUTPUT_DIR=/abs/path/to/output-root
# SIMANEAT_APPS_TEST_KEEP_OUTPUT=1
# SIMANEAT_APPS_TEST_TIMEOUT_MS=180000

# Optional Python interpreter override. Use this when Python tests should run
# against a specific pyneat or SDK virtual environment.
# PYTHON_TEST_BIN=/abs/path/to/python3
