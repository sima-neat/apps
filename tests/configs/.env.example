# Copy this file to tests/configs/.env.local and set values for your board or runner.
# tests/configs/.env.local is ignored by git and auto-loaded by tests/test.sh.

# Repository root. Default: directory containing this tests/ folder.
# APPS_ROOT=/abs/path/to/sima-neat/apps

# Python interpreter override. Default: auto-detected pyneat/python3 with pytest.
# PYTHON_TEST_BIN=/abs/path/to/python3

# Local artifact paths.
# Default: ${APPS_ROOT}/examples
# Accepts the examples directory, one per-example test-scope.yaml, or a generated aggregate.
# SIMANEAT_APPS_TEST_SCOPE_FILE=/abs/path/to/examples

# Default: ${APPS_ROOT}/models
# SIMANEAT_APPS_TEST_MODELS_DIR=/abs/path/to/models

# Default: ${APPS_ROOT}/assets/datasets-test/coco
# SIMANEAT_APPS_TEST_INPUT_DIR=/abs/path/to/assets/datasets-test/coco

# Default: ${APPS_ROOT}/sandbox-test
# SIMANEAT_APPS_TEST_OUTPUT_DIR=/abs/path/to/sandbox-test

# Default: ${APPS_ROOT}/assets/datasets-test/imagenet/goldfish.jpeg
# SIMANEAT_APPS_TEST_CLASSIFICATION_IMAGE=/abs/path/to/goldfish.jpeg

# Keep generated e2e run folders after tests. Default: 1.
# SIMANEAT_APPS_TEST_KEEP_OUTPUT=1

# Write summary logs under ${SIMANEAT_APPS_TEST_OUTPUT_DIR}/summary. Default: 1.
# SIMANEAT_APPS_TEST_WRITE_SUMMARY_LOGS=1

# Write per-example command/stdout/stderr logs. Default: 1.
# SIMANEAT_APPS_TEST_WRITE_PROCESS_LOGS=1

# Skip automatic model download before e2e tests. Default: 0.
# NEAT_APPS_SKIP_MODEL_DOWNLOAD=0

# Single RTSP H.264 stream URL for single-stream H.264 e2e tests. Default: unset.
# SIMANEAT_TEST_RTSP_H264_URL=rtsp://<host>:<port>/<stream>

# Comma-separated RTSP H.264 URLs for multistream H.264 e2e tests. Default: unset.
# SIMANEAT_TEST_RTSP_H264_URLS=rtsp://<host>:<port>/<stream0>,rtsp://<host>:<port>/<stream1>

# Single RTSP H.265 source used by decoded-input e2e tests.
# SIMANEAT_TEST_RTSP_H265_URL=rtsp://<host>:<port>/<stream>

# Comma-separated RTSP H.265 sources used by multistream e2e tests.
# SIMANEAT_TEST_RTSP_H265_URLS=rtsp://<host>:<port>/<stream0>,rtsp://<host>:<port>/<stream1>

# Single RTSP MJPEG stream URL for single-stream MJPEG e2e tests. Default: unset.
# SIMANEAT_TEST_RTSP_MJPEG_URL=rtsp://<host>:<port>/<stream>

# Comma-separated RTSP MJPEG URLs. Default: unset.
# SIMANEAT_TEST_RTSP_MJPEG_URLS=rtsp://<host>:<port>/<stream0>,rtsp://<host>:<port>/<stream1>

# Single HTTP MJPEG stream URL for single-stream MJPEG e2e tests. Default: unset.
# SIMANEAT_TEST_HTTP_MJPEG_URL=http://<host>:<port>/<stream>.mjpg

# Comma-separated HTTP MJPEG URLs. Default: unset.
# SIMANEAT_TEST_HTTP_MJPEG_URLS=http://<host>:<port>/<stream0>.mjpg,http://<host>:<port>/<stream1>.mjpg

# Test subprocess timeout in milliseconds. Default: 180000.
# SIMANEAT_APPS_TEST_TIMEOUT_MS=180000

# Strict e2e mode. Prefer tests/test.sh --strict. Default: 0.
# SIMANEAT_APPS_TEST_REQUIRE_E2E=0

# Optional labels file override for tests that support it. Default: unset.
# SIMANEAT_APPS_TEST_LABELS_FILE=/abs/path/to/labels.txt

# Optional Insight endpoint overrides for tests that support them.
# Default host: 127.0.0.1.
# SIMANEAT_APPS_TEST_INSIGHT_HOST=127.0.0.1
# SIMANEAT_APPS_TEST_INSIGHT_VIDEO_PORT=9000
# SIMANEAT_APPS_TEST_INSIGHT_METADATA_PORT=9100
