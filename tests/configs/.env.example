# Copy this file to tests/configs/.env.local and set values for your board or runner.
# tests/configs/.env.local is ignored by git and auto-loaded by tests/test.sh.

# Repository root. Default: directory containing this tests/ folder.
# APPS_ROOT=/abs/path/to/sima-neat/apps

# Python interpreter override. Default: auto-detected pyneat/python3 with pytest.
# PYTHON_TEST_BIN=/abs/path/to/python3

# Local artifact paths.
# Default: ${APPS_ROOT}/tests/configs/test-scope.yaml
# SIMANEAT_APPS_TEST_SCOPE_FILE=/abs/path/to/tests/configs/test-scope.yaml

# Default: ${APPS_ROOT}/assets/models
# SIMANEAT_APPS_TEST_MODELS_DIR=/abs/path/to/assets/models

# Default: ${APPS_ROOT}/assets/test_images
# SIMANEAT_APPS_TEST_INPUT_DIR=/abs/path/to/assets/test_images

# Default: ${APPS_ROOT}/sandbox-test
# SIMANEAT_APPS_TEST_OUTPUT_DIR=/abs/path/to/sandbox-test

# Default: ${APPS_ROOT}/assets/test_images_classification/goldfish.jpeg
# SIMANEAT_APPS_TEST_CLASSIFICATION_IMAGE=/abs/path/to/goldfish.jpeg

# Keep generated e2e run folders after tests. Default: 1.
# SIMANEAT_APPS_TEST_KEEP_OUTPUT=1

# Write summary logs under ${SIMANEAT_APPS_TEST_OUTPUT_DIR}/summary. Default: 1.
# SIMANEAT_APPS_TEST_WRITE_SUMMARY_LOGS=1

# Write per-example command/stdout/stderr logs. Default: 1.
# SIMANEAT_APPS_TEST_WRITE_PROCESS_LOGS=1

# Skip automatic model download before e2e tests. Default: 0.
# NEAT_APPS_SKIP_MODEL_DOWNLOAD=0

# Single RTSP stream URL for single-stream e2e tests. Default: unset.
# SIMANEAT_APPS_TEST_RTSP_URL=rtsp://<host>:<port>/<stream>

# Comma-separated RTSP URLs for multistream e2e tests. Default: unset.
# SIMANEAT_APPS_TEST_RTSP_URLS=rtsp://<host>:<port>/<stream0>,rtsp://<host>:<port>/<stream1>

# Test subprocess timeout in milliseconds. Default: 180000.
# SIMANEAT_APPS_TEST_TIMEOUT_MS=180000

# Strict e2e mode. Prefer tests/test.sh --strict. Default: 0.
# SIMANEAT_APPS_TEST_REQUIRE_E2E=0

# Optional labels file override for tests that support it. Default: unset.
# SIMANEAT_APPS_TEST_LABELS_FILE=/abs/path/to/labels.txt

# Optional Insight endpoint overrides for tests that support them.
# Default host: 127.0.0.1.
# SIMANEAT_APPS_TEST_INSIGHT_HOST=127.0.0.1
# SIMANEAT_APPS_TEST_INSIGHT_VIDEO_PORT=9000
# SIMANEAT_APPS_TEST_INSIGHT_METADATA_PORT=9100
