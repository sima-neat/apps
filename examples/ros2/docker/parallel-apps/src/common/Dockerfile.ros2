# The board supplies its installed Neat/ROS libraries through read-only mounts.
FROM scratch
ENV PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp
ENTRYPOINT ["/bin/bash", "-c", "source /usr/local/ros2/setup.bash && export VIRTUAL_ENV=\"$PYNEAT_ROOT\" PATH=\"$PYNEAT_ROOT/bin:$PATH\" && source install/setup.bash && exec ros2 launch \"$ROS_APP_PACKAGE\" app.launch.py config:=\"$PWD/src/common/config.yaml\" source:=live namespace:=\"$ROS_APP_NAMESPACE\""]
